# Enhanced Supabase Configuration for React Vite Application
# Copy this file to .env in your project root and update with your actual Supabase credentials

# ===== SUPABASE CONFIGURATION =====
# Your Supabase project URL
# Format: https://your-project-ref.supabase.co
# You can find this in: Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://jbaotyeeezzvsqihxpwe.supabase.co

# Your Supabase anonymous/public key
# This is safe to expose in frontend applications
# Starts with: eyJ...
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpiYW90eWVlZXp6dnNxaWh4cHdlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjIzNjQ5OTUsImV4cCI6MjA3Nzk0MDk5NX0._s8GbTRZnK-obJw5tHheh2-0_OFqiXp6uNlJxWe8Mcs

# ===== DEVELOPMENT SETTINGS =====
NODE_ENV=development

# ===== APPLICATION SETTINGS =====
VITE_APP_NAME=Tafaneen Order Bloom
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Professional stationery and office supplies e-commerce platform

# ===== DEVELOPMENT SETTINGS =====
# CORS settings for development
VITE_CORS_ORIGIN=http://localhost:5173

# Debug settings
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=debug

# ===== AUTHENTICATION SETTINGS =====
# OAuth providers (configure in Supabase Dashboard > Authentication)
VITE_GOOGLE_OAUTH_ENABLED=true
VITE_GITHUB_OAUTH_ENABLED=false

# Session configuration
VITE_SESSION_TIMEOUT=3600
VITE_REFRESH_TOKEN_THRESHOLD=300

# ===== DATABASE SETTINGS =====
# Database connection pooling
VITE_DB_POOL_SIZE=10
VITE_DB_TIMEOUT=30000

# Real-time settings
VITE_REALTIME_ENABLED=true
VITE_REALTIME_TIMEOUT=30000

# ===== SECURITY SETTINGS =====
# CORS configuration
VITE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
VITE_RATE_LIMIT_WINDOW=15
VITE_RATE_LIMIT_MAX=100

# ===== MONITORING & ANALYTICS =====
# Enable error tracking
VITE_ERROR_TRACKING=true
VITE_ANALYTICS_ENABLED=true

# ===== FEATURE FLAGS =====
VITE_ENABLE_DIAGNOSTICS=true
VITE_ENABLE_TESTING_UTILS=true

# ===== SUPABASE FEATURES =====
# Enable additional Supabase features
VITE_SUPABASE_REALTIME=true
VITE_SUPABASE_STORAGE=true
VITE_SUPABASE_EDGE_FUNCTIONS=false

# ===== NOTIFICATION SETTINGS =====
# Push notifications
VITE_PUSH_NOTIFICATIONS_ENABLED=false
VITE_EMAIL_NOTIFICATIONS_ENABLED=true

# ===== PERFORMANCE SETTINGS =====
# Enable performance monitoring
VITE_PERFORMANCE_MONITORING=true
VITE_BUNDLE_ANALYZER=false

# ===== SECURITY HEADERS =====
# Content Security Policy
VITE_CSP_ENABLED=true
VITE_CSP_REPORT_URI=/api/csp-report

# ===== DEVELOPMENT HELPERS =====
# Enable development tools
VITE_DEV_TOOLS=true
VITE_HOT_RELOAD=true
VITE_SOURCE_MAPS=true
